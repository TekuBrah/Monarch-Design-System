{
  "name": "@monarch/design-system",
  "private": true,
  "version": "1.15.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:tokens": "node scripts/build-brand-colors.mjs && node scripts/build-alias-colors.mjs && node scripts/build-mapped.mjs && node scripts/build-responsive.mjs && node scripts/build-typography.mjs && node scripts/build-gradients.mjs && node scripts/build-shadows.mjs",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "check:css-registration": "node scripts/check-css-registration.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@material-design-icons/svg": "^0.14.15",
    "vite-plugin-svgr": "^5.2.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
